# URL pública de la aplicación (opcional, para desarrollo local)
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# PINs de acceso (configura estos en Cloudflare Pages → Settings → Variables)
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_PIN="SIG900.1"
PUBLISHER_PIN="9001"

# ─────────────────────────────────────────────────────────────────────────────
# GitHub API — para que el ADMIN pueda guardar módulos y noticias desde la UI
# El token debe tener permiso: Contents → Read and write (en el repositorio)
#
# Cómo crear el token:
#   1. Ve a https://github.com/settings/tokens?type=beta (Fine-grained token)
#   2. Repository access: Solo "GUAPP"
#   3. Permissions → Contents → Read and write
#   4. Genera el token y cópialo aquí
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN="github_pat_XXXXXXXX"
GITHUB_OWNER="supergestionesintegrales-web"
GITHUB_REPO="GUAPP"
GITHUB_BRANCH="main"
